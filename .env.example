# ---------------------------------------------------------------------------
# 可选配置：大模型（AI 解读 / 报价兜底），不配置时主流程仍可用 Yahoo 行情
#
# provider 三选一：
#   perplexity 内置联网检索并返回引用（AI 解读默认）
#   deepseek   OpenAI 兼容，https://api.deepseek.com（报价兜底默认）
#   custom     任意 OpenAI 兼容服务（例如小米 MiMo 等），需填 *_LLM_BASE_URL
# ---------------------------------------------------------------------------

# ---- AI 解读（默认 Perplexity，联网检索带引用）----
LLM_PROVIDER=perplexity
LLM_MODEL=sonar
# custom 时必填：OpenAI 兼容的 chat completions 地址
# LLM_BASE_URL=

# ---- 报价兜底（默认 DeepSeek，Yahoo 完全不可用时才调用）----
QUOTE_LLM_PROVIDER=deepseek
QUOTE_LLM_MODEL=deepseek-flash
# QUOTE_LLM_BASE_URL=

# ---- 密钥：按 provider 取，LLM_API_KEY 对所有 provider 生效 ----
# LLM_API_KEY=
# PERPLEXITY_API_KEY=      # 申请地址 https://www.perplexity.ai/settings/api
# DEEPSEEK_API_KEY=
# CUSTOM_LLM_API_KEY=
