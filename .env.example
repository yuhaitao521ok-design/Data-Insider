# ---------------------------------------------------------------------------
# 可选配置：Perplexity AI（用于「AI 解读」以及 Yahoo 不可用时的兜底报价）
# 申请地址：https://www.perplexity.ai/settings/api
# 不配置该变量时，应用仍然可以正常使用 Yahoo 的行情数据。
# ---------------------------------------------------------------------------
PERPLEXITY_API_KEY=

# 使用的 Perplexity 模型，默认 sonar
PERPLEXITY_MODEL=sonar
